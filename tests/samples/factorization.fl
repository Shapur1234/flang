program factorization;

proc factorize(n: Int);
var d: Int;
{
	if n = 0 then {
		writeln(0);
		exit;
	};

	if n < 0 then {
		writeln(-1);
		n := -1 * n;
	};

	d := 2;
	while TRUE do {
		if (d * d > n) then break;

		while n % d = 0 do {
			writeln(d);
			n := n / d;
		};
		d := d + 1;
	};

	if n > 1 then {
		writeln(n);
	};
};

{
	factorize(readln());
}.
